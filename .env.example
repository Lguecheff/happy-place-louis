# Copie ce fichier en .env puis remplace les deux valeurs par celles de TON projet Supabase
# (Supabase > Project Settings > API, ou bouton « Connect » en haut du tableau de bord).
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# Facultatif : « true » rallume l entrée libre (session anonyme et choix du rôle). Absente : connexion par mot de passe.
# VITE_ENTREE_LIBRE="true"
